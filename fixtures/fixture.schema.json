{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apgiframework/apgi-framework/fixtures/fixture.schema.json",
  "title": "APGI golden fixture file",
  "type": "object",
  "required": ["schema", "generator", "generator_version", "model_variant", "model_version",
               "reference_arithmetic", "tolerance", "approval", "fixture"],
  "properties": {
    "schema": {"const": "fixtures/fixture.schema.json"},
    "generator": {"type": "string"},
    "generator_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "model_variant": {"type": "string", "pattern": "^MV-[A-Z0-9-]+$"},
    "model_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "reference_arithmetic": {"type": "string"},
    "tolerance": {
      "type": "object",
      "required": ["default", "S_t", "theta", "boundary_band_ulp"],
      "properties": {
        "default": {"$ref": "#/$defs/tol"},
        "S_t": {"$ref": "#/$defs/tol"},
        "theta": {"$ref": "#/$defs/tol"},
        "boundary_band_ulp": {"type": "integer", "minimum": 0}
      }
    },
    "approval": {
      "type": "object",
      "required": ["status", "approver"],
      "properties": {
        "status": {"enum": ["provisional_unapproved", "approved"]},
        "approver": {"type": "string"}
      }
    },
    "fixture": {"enum": ["core-equations", "threshold-dynamics", "ignition-boundary",
                         "invalid-configurations", "noise-draws", "golden-vectors"]}
  },
  "$defs": {
    "tol": {
      "type": "object",
      "required": ["abs", "rel"],
      "properties": {"abs": {"type": "number", "minimum": 0}, "rel": {"type": "number", "minimum": 0}}
    }
  }
}
